# Copy to .env (docker-compose will auto-load it).
#
# All variables are optional; defaults shown in comments.

# Host path that becomes /library:ro inside the web container.
# Set this to your ASMR library root.
# default: ./samples (an empty placeholder directory in the repo)
#ASMR_LIBRARY_PATH=/mnt/d/ASMR

# Host port to expose the web UI on (loopback only — 127.0.0.1:<port>:8000).
# default: 8000
#ASMR_WEB_HOST_PORT=8000

# Log level for the web server. DEBUG / INFO / WARNING / ERROR.
# default: INFO
#ASMR_BALANCE_LOG_LEVEL=INFO

# Hypothesis profile for property tests (dev | ci).
# default: dev
#HYPOTHESIS_PROFILE=ci
